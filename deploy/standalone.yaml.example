apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: md-converter
spec:
  replicas: 1
  serviceName: md-converter
  selector:
    matchLabels:
      app.kubernetes.io/name: md-converter
  template:
    metadata:
      labels:
        app.kubernetes.io/name: md-converter
    spec:
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 0
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: Localhost
          localhostProfile: profiles/md-converter-chrome.json
      containers:
        - name: application
          image: ${MARKWEAVE_IMAGE}
          imagePullPolicy: IfNotPresent
          args: [embedded-worker]
          envFrom:
            - configMapRef:
                name: md-converter
            - secretRef:
                name: md-converter
          env:
            - name: MARKWEAVE_STORAGE_PROFILE
              value: standalone
            - name: MARKWEAVE_STANDALONE_DATA_DIRECTORY
              value: /data
            - name: MARKWEAVE_CLAMAV_HOST
              value: ${CLAMAV_SERVICE}
          ports:
            - name: http
              containerPort: 8080
          livenessProbe:
            httpGet: {path: /health/live, port: http}
          readinessProbe:
            httpGet: {path: /health/ready, port: http}
          resources:
            requests:
              memory: "${WORKER_MEMORY_BUDGET_BYTES}"
              ephemeral-storage: "${WORKER_EPHEMERAL_STORAGE_BUDGET_BYTES}"
            limits:
              memory: "${WORKER_MEMORY_BUDGET_BYTES}"
              ephemeral-storage: "${WORKER_EPHEMERAL_STORAGE_BUDGET_BYTES}"
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: work, mountPath: /work}
            - {name: temporary, mountPath: /tmp}
            - {name: shared-memory, mountPath: /dev/shm}
      volumes:
        - name: work
          emptyDir:
            sizeLimit: "${WORKER_EPHEMERAL_STORAGE_BUDGET_BYTES}"
        - name: temporary
          emptyDir:
            medium: Memory
            sizeLimit: "${TMP_LIMIT_BYTES}"
        - name: shared-memory
          emptyDir:
            medium: Memory
            sizeLimit: "${SHM_LIMIT_BYTES}"
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: "${DATA_STORAGE_QUANTITY}"
