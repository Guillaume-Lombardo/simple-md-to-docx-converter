# T74 reference topology. Every REQUIRED token must be rendered and validated.
apiVersion: v1
kind: Namespace
metadata:
  name: markweave-reverse
  labels:
    pod-security.kubernetes.io/enforce: restricted
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: markweave-reverse-attempt, namespace: markweave-reverse}
automountServiceAccountToken: false
---
apiVersion: v1
kind: Namespace
metadata:
  name: markweave-attestation
  labels:
    pod-security.kubernetes.io/enforce: privileged
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: markweave-reverse-broker, namespace: markweave-reverse}
automountServiceAccountToken: true
---
apiVersion: v1
kind: Secret
metadata: {name: markweave-reverse-broker-attester-tls, namespace: markweave-reverse}
type: kubernetes.io/tls
immutable: true
stringData:
  ca.crt: "@REQUIRED_ATTESTER_SERVER_CA_PEM@"
  tls.crt: "@REQUIRED_BROKER_CLIENT_CERTIFICATE_PEM@"
  tls.key: "@REQUIRED_BROKER_CLIENT_PRIVATE_KEY_PEM@"
---
apiVersion: v1
kind: ConfigMap
metadata: {name: markweave-reverse-broker-kubernetes, namespace: markweave-reverse}
immutable: true
data:
  kubernetes.json: |
    {
      "namespace": "markweave-reverse",
      "attester_port": 9443,
      "attester_server_ca_file": "/run/markweave-attester-tls/ca.crt",
      "attester_client_certificate_file": "/run/markweave-attester-tls/tls.crt",
      "attester_client_private_key_file": "/run/markweave-attester-tls/tls.key",
      "expected_attester_server_certificate_sha256": "@REQUIRED_ATTESTER_SERVER_CERTIFICATE_SHA256@",
      "pod_scheduling_timeout_seconds": "@REQUIRED_POD_SCHEDULING_TIMEOUT_SECONDS@",
      "pod_exec_timeout_seconds": "@REQUIRED_POD_EXEC_TIMEOUT_SECONDS@",
      "pod_poll_interval_seconds": "@REQUIRED_POD_POLL_INTERVAL_SECONDS@",
      "attester_max_request_bytes": "@REQUIRED_ATTESTER_MAX_REQUEST_BYTES@",
      "attester_max_response_bytes": "@REQUIRED_ATTESTER_MAX_RESPONSE_BYTES@",
      "attester_request_timeout_seconds": "@REQUIRED_ATTESTER_REQUEST_TIMEOUT_SECONDS@"
    }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: markweave-reverse-broker, namespace: markweave-reverse}
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["create", "delete", "get", "list", "watch"]
  - apiGroups: [""]
    resources: ["pods/exec"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: markweave-reverse-broker, namespace: markweave-reverse}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: markweave-reverse-broker
subjects:
  - kind: ServiceAccount
    name: markweave-reverse-broker
    namespace: markweave-reverse
---
# This RuntimeClass handler exists only on nodes whose CNI configuration creates
# a loopback-only sandbox. A NetworkPolicy is intentionally not treated as proof.
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata: {name: markweave-reverse}
handler: markweave-reverse
scheduling:
  nodeSelector:
    reverse.markweave.dev/isolation-pool: reverse
    reverse.markweave.dev/node-fence: "@REQUIRED_NODE_FENCE_REVISION@"
  tolerations:
    - effect: NoSchedule
      key: reverse.markweave.dev/dedicated
      operator: Equal
      value: reverse
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: markweave-node-attester, namespace: markweave-attestation}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata: {name: markweave-node-attester-config, namespace: markweave-attestation}
immutable: true
data:
  attester.json: |
    {
      "listen_address": "0.0.0.0:9443",
      "client_ca_file": "/run/markweave-tls/ca.crt",
      "server_certificate_file": "/run/markweave-tls/tls.crt",
      "server_private_key_file": "/run/markweave-tls/tls.key",
      "require_client_certificate": true,
      "expected_client_certificate_sha256": "@REQUIRED_BROKER_CLIENT_CERTIFICATE_SHA256@",
      "max_request_bytes": "@REQUIRED_ATTESTER_MAX_REQUEST_BYTES@",
      "max_response_bytes": "@REQUIRED_ATTESTER_MAX_RESPONSE_BYTES@",
      "request_timeout_seconds": "@REQUIRED_ATTESTER_REQUEST_TIMEOUT_SECONDS@"
    }
---
apiVersion: v1
kind: Secret
metadata: {name: markweave-node-attester-tls, namespace: markweave-attestation}
type: kubernetes.io/tls
immutable: true
stringData:
  ca.crt: "@REQUIRED_BROKER_CLIENT_CA_PEM@"
  tls.crt: "@REQUIRED_ATTESTER_CERTIFICATE_PEM@"
  tls.key: "@REQUIRED_ATTESTER_PRIVATE_KEY_PEM@"
---
apiVersion: apps/v1
kind: DaemonSet
metadata: {name: markweave-node-attester, namespace: markweave-attestation}
spec:
  selector:
    matchLabels: {app.kubernetes.io/name: markweave-node-attester}
  template:
    metadata:
      labels: {app.kubernetes.io/name: markweave-node-attester}
    spec:
      automountServiceAccountToken: false
      enableServiceLinks: false
      hostNetwork: false
      nodeSelector:
        reverse.markweave.dev/isolation-pool: reverse
        reverse.markweave.dev/node-fence: "@REQUIRED_NODE_FENCE_REVISION@"
      serviceAccountName: markweave-node-attester
      tolerations:
        - effect: NoSchedule
          key: reverse.markweave.dev/dedicated
          operator: Equal
          value: reverse
      containers:
        - name: attester
          image: "@REQUIRED_ATTESTER_IMAGE_REPOSITORY@@@REQUIRED_ATTESTER_IMAGE_DIGEST@"
          imagePullPolicy: IfNotPresent
          args: ["node-attester", "--config", "/etc/markweave/attester.json"]
          env:
            - name: MARKWEAVE_ATTESTER_NODE_NAME
              valueFrom: {fieldRef: {fieldPath: spec.nodeName}}
          ports:
            - name: mtls-attester
              containerPort: 9443
              hostPort: 9443
              protocol: TCP
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
            privileged: false
            readOnlyRootFilesystem: true
            runAsNonRoot: false
            runAsUser: 0
            seccompProfile: {type: RuntimeDefault}
          volumeMounts:
            - {name: cri, mountPath: /run/containerd/containerd.sock}
            - {name: cgroup, mountPath: /sys/fs/cgroup, readOnly: true}
            - {name: config, mountPath: /etc/markweave, readOnly: true}
            - {name: tls, mountPath: /run/markweave-tls, readOnly: true}
      volumes:
        - name: cri
          hostPath: {path: /run/containerd/containerd.sock, type: Socket}
        - name: cgroup
          hostPath: {path: /sys/fs/cgroup, type: Directory}
        - name: config
          configMap: {name: markweave-node-attester-config, defaultMode: 256}
        - name: tls
          secret: {secretName: markweave-node-attester-tls, defaultMode: 256}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata: {name: markweave-node-attester, namespace: markweave-attestation}
spec:
  maxUnavailable: 0
  selector:
    matchLabels: {app.kubernetes.io/name: markweave-node-attester}
