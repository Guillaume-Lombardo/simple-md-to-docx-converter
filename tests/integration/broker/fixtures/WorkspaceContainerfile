ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER 0
RUN test -x /opt/markweave/venv/bin/python \
    && env -i /opt/markweave/venv/bin/python -E -c 'import importlib.util, pathlib, sys; destination = pathlib.Path("/opt/markweave/venv/lib/python3.14/site-packages"); executable = pathlib.Path("/opt/markweave/venv/bin/python").resolve(); specification = importlib.util.find_spec("markweave.reversions.attempt_main"); valid = sys.version_info[:2] == (3, 14) and pathlib.Path(sys.executable).resolve() == executable and pathlib.Path(sys.prefix).resolve() == pathlib.Path("/opt/markweave/venv").resolve() and str(destination) in sys.path and specification is not None and specification.origin is not None and pathlib.Path(specification.origin).resolve().parent == destination / "markweave/reversions"; raise SystemExit(0 if valid else 1)'
COPY LICENSE /opt/markweave/licenses/markweave/LICENSE
COPY src/markweave/reversions \
    /opt/markweave/venv/lib/python3.14/site-packages/markweave/reversions
RUN find /opt/markweave/venv/lib/python3.14/site-packages/markweave/reversions \
        -type f -name '*.pyc' -delete \
    && chmod -R a-w \
        /opt/markweave/venv/lib/python3.14/site-packages/markweave/reversions
USER 1001:0
