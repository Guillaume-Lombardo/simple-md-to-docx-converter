# Local conversion settings for `markweave convert --local` (decision D1).
#
# These are the same MARKWEAVE_* conversion, engine, and template variables the
# service reads, copied from the quickstart values in compose.yaml. They are
# evaluation values, not sized production limits: review them for your workload.
# The engine paths match the final image; adjust them for host engines.
#
# Container: podman run --env-file examples/local-conversion.env ...
# Host shell: set -a; . examples/local-conversion.env; set +a
MARKWEAVE_CONVERSION_UPLOAD_MAX_BYTES=1000000
MARKWEAVE_CONVERSION_MAX_DECOMPRESSED_BYTES=2000000
MARKWEAVE_CONVERSION_MAX_FILES=100
MARKWEAVE_CONVERSION_MAX_IMAGES=50
MARKWEAVE_CONVERSION_MAX_DIAGRAMS=20
MARKWEAVE_CONVERSION_MAX_COMPRESSION_RATIO=200
MARKWEAVE_CONVERSION_IMAGE_MAX_SOURCE_BYTES=1000000
MARKWEAVE_CONVERSION_IMAGE_MAX_WIDTH_PIXELS=2000
MARKWEAVE_CONVERSION_IMAGE_MAX_HEIGHT_PIXELS=2000
MARKWEAVE_CONVERSION_IMAGE_MAX_PIXELS=4000000
MARKWEAVE_CONVERSION_IMAGE_MAX_SVG_ELEMENTS=10000
MARKWEAVE_CONVERSION_IMAGE_MAX_SVG_DEPTH=64
MARKWEAVE_CONVERSION_MERMAID_MAX_SOURCE_BYTES=100000
MARKWEAVE_CONVERSION_MERMAID_MAX_TOTAL_SOURCE_BYTES=2000000
MARKWEAVE_CONVERSION_MERMAID_MAX_OUTPUT_BYTES=1000000
MARKWEAVE_CONVERSION_MERMAID_MAX_TOTAL_OUTPUT_BYTES=20000000
MARKWEAVE_CONVERSION_MERMAID_MAX_WIDTH_PIXELS=2000
MARKWEAVE_CONVERSION_MERMAID_MAX_HEIGHT_PIXELS=2000
MARKWEAVE_CONVERSION_MERMAID_EXECUTABLE=mmdc
MARKWEAVE_CONVERSION_CHROMIUM_EXECUTABLE=/usr/bin/google-chrome-stable
MARKWEAVE_CONVERSION_PDF_CANCELLATION_POLL_SECONDS=0.1
MARKWEAVE_CONVERSION_PDF_MAX_BYTES=20000000
MARKWEAVE_CONVERSION_PDF_MAX_DECODED_STREAM_BYTES=20000000
MARKWEAVE_CONVERSION_PDF_MAX_PAGES=5
MARKWEAVE_CONVERSION_PDF_MAX_OBJECTS=100000
MARKWEAVE_CONVERSION_PDF_MAX_OBJECT_DEPTH=100
MARKWEAVE_CONVERSION_FONT_MANIFEST_PATH=/opt/md-converter/font-manifest.json
MARKWEAVE_TEMPLATE_MAX_ARCHIVE_BYTES=1000000
MARKWEAVE_TEMPLATE_MAX_ENTRIES=2000
MARKWEAVE_TEMPLATE_MAX_MEMBER_BYTES=1000000
MARKWEAVE_TEMPLATE_MAX_TOTAL_BYTES=2000000
MARKWEAVE_TEMPLATE_MAX_COMPRESSION_RATIO=200
MARKWEAVE_TEMPLATE_MAX_XML_ELEMENTS=250000
MARKWEAVE_TEMPLATE_MAX_XML_DEPTH=100
MARKWEAVE_TEMPLATE_MAX_XML_ATTRIBUTES=500000
MARKWEAVE_TEMPLATE_MAX_DECLARED_FONTS=64
MARKWEAVE_TEMPLATE_MAX_FONT_NAME_CHARACTERS=128
MARKWEAVE_TEMPLATE_PANDOC_EXECUTABLE=pandoc
MARKWEAVE_TEMPLATE_LIBREOFFICE_EXECUTABLE=soffice
MARKWEAVE_TEMPLATE_ENGINE_TIMEOUT_SECONDS=30
MARKWEAVE_TEMPLATE_ENGINE_TERMINATION_GRACE_SECONDS=1
