ARG BUILDER_IMAGE=registry.access.redhat.com/ubi9/nodejs-24@sha256:2bae1ec6e0e4892583459f1709426fb6bfa67ed2fa2b4b974645b644d10e9693
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/nodejs-24-minimal@sha256:ec0fcd4a3b6c64a1b9b1571c9528172508471f8a295f857215057a140aa5f2b4

FROM ${BUILDER_IMAGE} AS build
USER 0
WORKDIR /opt/app-root/src
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN test "$(node --version)" = "v24.19.0" && test "$(npm --version)" = "11.17.0" \
    && npm ci --ignore-scripts
COPY app ./app
COPY components ./components
COPY public ./public
COPY src ./src
COPY next-env.d.ts next.config.ts postcss.config.mjs proxy.ts tsconfig.json ./
RUN npm run build && npm prune --omit=dev --ignore-scripts && npm cache clean --force

FROM ${RUNTIME_IMAGE} AS runtime
USER 0
WORKDIR /opt/markweave-web
ENV HOME=/tmp/home \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=160 \
    NPM_CONFIG_CACHE=/tmp/npm-cache \
    PORT=3000 \
    PROBE_PORT=3001
COPY --from=build --chown=1001:0 /opt/app-root/src/.next ./.next
COPY --from=build --chown=1001:0 /opt/app-root/src/node_modules ./node_modules
COPY --from=build --chown=1001:0 /opt/app-root/src/package.json ./package.json
COPY --from=build --chown=1001:0 /opt/app-root/src/public ./public
COPY --chown=1001:0 server.mjs ./server.mjs
COPY --chown=1001:0 src/runtime ./src/runtime
RUN chmod -R g=u /opt/markweave-web && chmod -R a-w /opt/markweave-web
USER 1001
EXPOSE 3000 3001
CMD ["node", "server.mjs"]
